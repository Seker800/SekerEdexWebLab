# Copy to .env.local for local development; never commit the real file.
CONTENT_DATA_DIR=/absolute/private/path/seker-content-runtime
CONTENT_LISTEN_HOST=127.0.0.1
CONTENT_PORT=4175
CONTENT_REQUIRE_HTTPS=false
CONTENT_ADMIN_ORIGIN=http://127.0.0.1:4175
CONTENT_ADMIN_USERNAME=author
CONTENT_ADMIN_PASSWORD_HASH=
CONTENT_PUBLIC_ORIGINS=http://127.0.0.1:4174

# For compose.example.yml only: a private host directory owned by container UID 1000.
CONTENT_HOST_DATA_DIR=/absolute/private/path/seker-content-runtime
