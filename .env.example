# Public API origin used only by runtime static-site builds. It is embedded in browser code.
# Never put a password, token, private IP or database connection string here.
# SEKER_CONTENT_DELIVERY=runtime
# SEKER_CONTENT_API_ORIGIN=https://content.example.org

# Local development always loads the explicitly marked sample content in examples/blog.
# The content service has its own private services/content-api/.env.local file.
