# Copy this file to .env.local for local author preview and npm run publish:content.
# Relative paths are resolved from the SekerEdexWebLab repository root.
# Keep the selected directory outside this public repository when it has its own private Git history.
# The selected root must contain content-source.json with kind "author".
# npm run deploy:site deliberately removes this variable and never reads author content.
# SEKER_CONTENT_ROOT=../SekerEdexContent/blog
