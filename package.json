{
  "name": "seker-edex-web-lab",
  "version": "0.1.0",
  "description": "Unofficial browser port of eDEX-UI with deterministic visual replication tooling.",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "SekerW",
  "keywords": [
    "edex-ui",
    "browser-port",
    "terminal",
    "visual-regression"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run app:build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "content:coverage": "vitest run tests/content-registry.test.ts tests/content-tree.test.ts tests/content-location.test.ts tests/blog-content.test.ts tests/content-api-client.test.ts --coverage --coverage.include='apps/clone/src/content/*.ts' --coverage.thresholds.lines=80 --coverage.thresholds.branches=80 --coverage.thresholds.functions=80 --coverage.thresholds.statements=80",
    "content:verify": "tsx scripts/verify-content-source.ts",
    "content:verify:sample": "tsx scripts/verify-content-source.ts sample",
    "content:check": "npm run content:verify:sample && npm run content:coverage && npm run app:build",
    "content:serve": "node --env-file=services/content-api/.env.local --import tsx services/content-api/serve.ts",
    "content:hash-password": "tsx services/content-api/hash-password.ts",
    "content-api:build": "tsc -p tsconfig.content-api.json",
    "content-api:coverage": "vitest run tests/content-api.test.ts tests/content-http.test.ts --coverage --coverage.include='services/content-api/content-store.ts' --coverage.include='services/content-api/http.ts' --coverage.thresholds.lines=80 --coverage.thresholds.branches=80 --coverage.thresholds.functions=80 --coverage.thresholds.statements=80",
    "content:integration": "tsx scripts/verify-content-service.ts",
    "release:verify": "tsx scripts/verify-release-boundaries.ts",
    "deploy:site": "tsx scripts/deploy-site.ts",
    "run": "tsx src/cli.ts run",
    "demo": "tsx scripts/demo.ts",
    "app:dev": "vite apps/clone --host 127.0.0.1 --port 4174",
    "app:build": "vite build apps/clone --outDir ../../dist/clone --emptyOutDir",
    "app:verify": "tsx scripts/verify-app.ts",
    "app:verify:webkit": "tsx scripts/verify-webkit.ts",
    "app:hotspots": "tsx scripts/analyze-app-hotspots.ts",
    "gate:verify": "tsx scripts/verify-gate-integrity.ts",
    "assets:verify": "tsx scripts/verify-upstream-assets.ts",
    "upstream:sync": "tsx scripts/sync-upstream-source.ts",
    "replicate:repair": "tsx scripts/repair-replication.ts",
    "verify": "npm run gate:verify && npm run assets:verify && npm run release:verify && npm run content:verify && npm run check && npm test && npm run content:coverage && npm run content-api:coverage && npm run content-api:build && npm run build && npm run content:integration && npm run demo && npm run app:verify && npm run app:verify:webkit && npm run replicate:verify",
    "replicate:verify": "tsx scripts/verify-replication.ts",
    "install:browsers": "playwright install chromium webkit"
  },
  "dependencies": {
    "@vfx-js/core": "^1.1.0",
    "markdown-it": "^15.0.2",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
